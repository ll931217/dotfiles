[
  {
    "plugin_id": "chmarax.herdr-nvim",
    "name": "herdr-nvim",
    "version": "1.0.0",
    "min_herdr_version": "0.7.4",
    "description": "Full-height nvim sidebar with agent annotations: toggle with one key, comment code, send to any agent.",
    "manifest_path": "/home/liangshih.lin/GitHub/ai-repos/herdr-nvim/herdr-plugin.toml",
    "plugin_root": "/home/liangshih.lin/GitHub/ai-repos/herdr-nvim",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "build": [
      {
        "command": [
          "bash",
          "herdr/install.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "open-link",
        "title": "nvim sidebar: open clicked file",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" open-link"
        ]
      },
      {
        "id": "pick-file",
        "title": "nvim sidebar: open file from agent output",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" pick-file"
        ]
      },
      {
        "id": "toggle",
        "title": "nvim sidebar: toggle",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" toggle"
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "open file",
        "placement": "popup",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" picker"
        ]
      },
      {
        "id": "sidebar",
        "title": "nvim sidebar",
        "placement": "split",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" sidebar"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "file-path",
        "title": "Open in nvim sidebar",
        "pattern": "^~?[\\w.@/()\\[\\]+-]+/[\\w.@()\\[\\]+-]+\\.[A-Za-z]\\w*(?::\\d+){0,2}$",
        "action": "open-link"
      },
      {
        "id": "file-url",
        "title": "Open in nvim sidebar",
        "pattern": "^file://",
        "action": "open-link"
      }
    ],
    "source": {
      "kind": "local"
    }
  },
  {
    "plugin_id": "persiyanov.reviewr",
    "name": "reviewr",
    "version": "0.36.2",
    "min_herdr_version": "0.7.5",
    "description": "Review agent-written diffs beside the chat and add line comments to the agent input.",
    "manifest_path": "/home/liangshih.lin/GitHub/ai-repos/herdr-reviewr/herdr-plugin.toml",
    "plugin_root": "/home/liangshih.lin/GitHub/ai-repos/herdr-reviewr",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "build": [
      {
        "command": [
          "bash",
          "herdr/install.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "close",
        "title": "reviewr: close pane",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "bash",
          "herdr/pane.sh",
          "close"
        ]
      },
      {
        "id": "open",
        "title": "reviewr: open pane",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "bash",
          "herdr/pane.sh",
          "open"
        ]
      },
      {
        "id": "toggle",
        "title": "reviewr: toggle pane",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "bash",
          "herdr/pane.sh",
          "toggle"
        ]
      }
    ],
    "events": [
      {
        "on": "worktree.created",
        "command": [
          "bash",
          "herdr/pane.sh",
          "auto-open"
        ]
      },
      {
        "on": "worktree.opened",
        "command": [
          "bash",
          "herdr/pane.sh",
          "auto-open"
        ]
      }
    ],
    "panes": [
      {
        "id": "pane",
        "title": "reviewr",
        "placement": "split",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/bin/herdr-reviewr\""
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
