    "plugin_root": "/home/liangshih.lin/.config/herdr/plugins/github/worktrunk-7fb519583f31",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "actions": [
      {
        "id": "open",
        "title": "Worktree: switch / create from default branch",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" picker-default"
        ]
      },
      {
        "id": "open-current",
        "title": "Worktree: switch / create from current branch",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" picker-current"
        ]
      },
      {
        "id": "open-with-remotes",
        "title": "Worktree: switch / create from local or remote branches",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" picker-with-remotes"
        ]
      },
      {
        "id": "remove",
        "title": "Worktree: remove",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" remover"
        ]
      }
    ],
    "panes": [
      {
        "id": "picker-current",
        "title": "Worktrunk — current branch",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/picker.sh\" --create-base=current"
        ]
      },
      {
        "id": "picker-default",
        "title": "Worktrunk — default branch",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/picker.sh\" --create-base=default"
