# Private and generated files never belong in managed source state.
.config/zsh/keys.zsh
.config/hypr/custom/private.env
.config/btop/btop.log
.config/worktrunk/worktrunk-receipt.json

# Optional asset bundles are enabled explicitly during migration.
.local/share/fonts
.wallpapers

# Never export Omarchy runtime data, local approvals, or retired host state.
.local/state/omarchy-inspired
.local/share/omarchy-inspired
.config/hypr-omarchy/.git
.config/hypr-omarchy/__pycache__
.config/hypr-omarchy/.ruff_cache
.config/hypr-omarchy/.ui-design
.config/hypr-omarchy/*.backup.*

{{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") (eq (get .chezmoi.osRelease "id") "arch") (eq .machine.profile "personal") (eq .chezmoi.homeDir "/home/ll931217")) }}
# Existing-host alternate session, independent of the i3/Hyprland default.
# The reviewed scripts contain absolute paths; do not deploy to another HOME.
.config/hypr-omarchy
.local/bin/omarchy-inspired-session
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# macOS-only source paths are excluded on Linux.
.aerospace.toml
.config/alacritty/alacritty.yml
.config/htop
.config/neofetch
.config/sketchybar
.config/skhd
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# Linux-only window-manager and session paths are excluded on other systems.
.config/i3
.config/hypr
.config/awesome
.config/polybar
.config/rofi
.config/picom.conf
.config/dunst
.xprofile
{{- else }}
{{- if ne .machine.wm "i3" }}
.config/i3
{{- end }}

{{- if ne .machine.wm "hyprland" }}
.config/hypr
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "linux") (eq .machine.wm "i3") }}
# Eww replaces the old bars on both personal and work i3 desktops.
.config/polybar
.config/i3/i3status.conf
.config/i3/i3blocks.conf
.config/i3/i3_vici
{{- else }}
.config/eww
{{- end }}

{{- if not .machine.secrets }}
# Secret-backed files are skipped on machines without the gopass
# dotfiles-secrets/ namespace populated. Set machine.secrets = true
# in ~/.config/chezmoi/chezmoi.toml once the entries exist.
.config/zsh/private
{{- end }}

{{- if eq .machine.profile "work" }}
# VDI sessions use opaque widgets without a compositor.
.config/picom.conf
# Znap + fzf-tab policy file. The work profile runs antigen with no fzf-tab
# (bundles: chrissicool, MichaelAquilina, robbyrussell, spaceship-prompt,
# zsh-users), and work_zshrc never sources it, so it is dead weight there.
.config/zsh/completions.zsh
{{- end }}

{{- if not (and (eq .chezmoi.os "linux") (eq .machine.profile "personal") (eq .machine.wm "i3")) }}
# Terminal browser file picker is specific to personal i3 desktops.
.config/xdg-desktop-portal/i3-portals.conf
.config/xdg-desktop-portal-termfilechooser
.local/bin/yazi-file-picker
.local/share/applications/net.lutris.Lutris.desktop
{{- end }}
