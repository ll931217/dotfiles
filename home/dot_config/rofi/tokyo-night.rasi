* {
    /* Tokyo Night colors */
    bg: #1a1b26;
    bg-alt: #24283b;
    fg: #a9b1d6;
    fg-alt: #565f89;
    blue: #7aa2f7;
    cyan: #7dcfff;
    green: #9ece6a;
    red: #f7768e;
    yellow: #e0af68;
    magenta: #bb9af7;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrains Mono 10";
}

window {
    location: center;
    anchor: center;
    width: 500px;
    background-color: @bg;
    border: 2px;
    border-color: @blue;
    border-radius: 8px;
}

mainbox {
    enabled: true;
    orientation: vertical;
    spacing: 0px;
    children: [ "inputbar", "listview" ];
    background-color: transparent;
}

inputbar {
    enabled: true;
    padding: 12px 16px;
    spacing: 8px;
    background-color: @bg-alt;
    text-color: @fg;
    children: [ "prompt", "entry" ];
    border-radius: 8px 8px 0px 0px;
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @blue;
    padding: 0px 8px 0px 0px;
}

entry {
    enabled: true;
    background-color: transparent;
    text-color: @fg;
    cursor: text;
    placeholder: "Search...";
    placeholder-color: @fg-alt;
}

listview {
    enabled: true;
    columns: 1;
    lines: 12;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: false;
    fixed-columns: true;
    spacing: 4px;
    padding: 8px 12px;
    background-color: transparent;
}

element {
    enabled: true;
    padding: 4px 10px;
    spacing: 6px;
    background-color: transparent;
    text-color: @fg;
    cursor: pointer;
    border-radius: 4px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @blue;
    text-color: @bg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active {
    background-color: transparent;
    text-color: @green;
}

element selected.active {
    background-color: @green;
    text-color: @bg;
}

element normal.urgent {
    background-color: transparent;
    text-color: @red;
}

element selected.urgent {
    background-color: @red;
    text-color: @bg;
}

element-icon {
    size: 24px;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

message {
    enabled: false;
}

error-message {
    enabled: false;
}
