/* Amp: opaque warm surfaces shared with Eww and Dunst. */
* {
    font: "JetBrainsMono Nerd Font 10";
    background: #0F0F0F;
    surface: #161616;
    foreground: #F2ECDD;
    accent: #E7894C;
    muted: #A89F91;
    active: #7C9B96;
    urgent: #D9634F;
    background-color: transparent;
    text-color: @foreground;
    border-radius: 0px;
}

window {
    location: center;
    anchor: center;
    fullscreen: false;
    width: 640px;
    padding: 0px;
    border: 2px solid;
    border-color: @accent;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    padding: 18px;
    children: [ "inputbar", "mode-switcher", "listview" ];
}

inputbar {
    spacing: 12px;
    padding: 8px 0px 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 10";
}

entry {
    expand: true;
    cursor: text;
    placeholder: "Search...";
    placeholder-color: @muted;
}

mode-switcher {
    enabled: true;
    spacing: 6px;
}

button {
    padding: 8px 10px;
    background-color: @surface;
    text-color: @muted;
    cursor: pointer;
}

button selected {
    background-color: @accent;
    text-color: @background;
}

listview {
    columns: 1;
    lines: 9;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: true;
    fixed-columns: true;
    spacing: 4px;
}

element {
    spacing: 12px;
    padding: 8px 10px;
    cursor: pointer;
}

element normal.urgent { text-color: @urgent; }
element normal.active { text-color: @active; }
element selected.normal, element selected.urgent, element selected.active {
    background-color: @accent;
    text-color: @background;
}

element-icon {
    size: 20px;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
}

message { padding: 10px; background-color: @surface; }
