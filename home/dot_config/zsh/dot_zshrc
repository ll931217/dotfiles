# Single source of truth for interactive zsh config.
#
# ZDOTDIR is exported from ~/.zshenv (always read first), so this file is the
# one zsh reads in EVERY interactive shell — fresh login, tmux, ssh, flow, and
# nested shells alike. Keep all interactive setup here; ~/.zshrc is only a
# defensive shim for the case where ZDOTDIR somehow isn't set.

# zack.huang's shell helper
source "/home/liangshih.lin/.local/share/shell-helper/functions.sh"

# --- Plugin manager: antigen + oh-my-zsh ------------------------------------
# Download antigen if you haven't already
source $HOME/.config/antigen.zsh

# Load the oh-my-zsh's library.
antigen use oh-my-zsh

# ponytail: don't re-bind autosuggest widgets on every precmd, and skip the
# suggestion fetch entirely on long lines. See the strategy override after
# `atuin init` below for the real per-keystroke cost.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=60

antigen bundle zsh-users/zsh-autosuggestions
antigen bundle zsh-users/zsh-completions
antigen bundle zsh-users/zsh-history-substring-search

antigen bundle MichaelAquilina/zsh-autoswitch-virtualenv

# Bundles from the default repo (robbyrussell's oh-my-zsh).
antigen bundle git
antigen bundle heroku
antigen bundle pip
antigen bundle lein
antigen bundle command-not-found

# Syntax highlighting bundle.
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle chrissicool/zsh-256color

# antigen theme spaceship-prompt/spaceship-prompt

# Tell Antigen that you're done.
antigen apply

# --- Modular config ---------------------------------------------------------
# Keep $PATH free of duplicate entries (and dedupe whatever the login chain
# accumulated before this rc runs, e.g. .profile sourced twice under xrdp).
typeset -U path PATH

files=(
  "env"
  "aliases"
  "functions"
  "options"
  "proxy"
)

for file in "${files[@]}"; do
  [ -f "$ZDOTDIR/$file.zsh" ] && source "$ZDOTDIR/$file.zsh"
done

# --- Tool integrations (must run after modular config) ----------------------
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
eval "$(direnv hook zsh)"
eval "$(goose term init zsh)"
[[ -s "/etc/grc.zsh" ]] && source /etc/grc.zsh
eval "$(atuin init zsh)"
# ponytail: atuin init prepends itself to ZSH_AUTOSUGGEST_STRATEGY, so every
# keystroke (and every vicmd movement key) forks `atuin search` — measured
# ~163ms of CPU per fetch against the 6.9MB history.db. Ctrl-R still uses atuin;
# inline suggestions fall back to zsh history (sub-ms). Drop this line if you
# want cross-machine suggestions more than you want a responsive prompt.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
eval "$(tv init zsh)"
eval "$(sesh completion zsh)"
source <(gwq completion zsh)
eval "$(ast-grep completions)"
eval "$(gopass completion zsh)"
# bun completions
[ -s "/home/liangshih.lin/.bun/_bun" ] && source "/home/liangshih.lin/.bun/_bun"

# --- xrdp DISPLAY auto-detect (tmux) ----------------------------------------
# Auto-detect the current DISPLAY from the most recent Xorg process owned by
# this user. This handles xrdp reconnects where the display number changes and
# tmux's global environment still holds a stale value.
if [[ -n "$TMUX" ]]; then
  # Find the most recently started Xorg process (smallest elapsed time) for this user
  _xrdp_display=$(ps -u "$USER" -o etimes=,args= 2>/dev/null \
    | grep '[X]org :[0-9]' \
    | sort -n \
    | head -1 \
    | grep -oP 'Xorg :\K\d+')
  if [[ -n "$_xrdp_display" ]]; then
    export DISPLAY=":${_xrdp_display}.0"
    # Also fix tmux global env so other tools pick it up
    tmux set-environment -g DISPLAY "$DISPLAY" 2>/dev/null
  fi
  unset _xrdp_display
fi

# ponytail: fix unreadable blue-on-green for other-writable dirs (/mnt).
# Replace (not append) — zsh complist won't override an earlier duplicate entry.
export LS_COLORS="${LS_COLORS//ow=34;42/ow=01;34}"
export LS_COLORS="${LS_COLORS//tw=30;42/tw=01;34}"
zstyle ":completion:*" list-colors "${(s.:.)LS_COLORS}"
