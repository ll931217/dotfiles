# Dunst Configuration - Amp theme (mirrors alacritty amp.toml / i3 bar)
# vim: ft=cfg

[global]
    ### Display ###
    monitor = 0
    follow = mouse

    ### Geometry ###
    width = 320
    height = 150
    origin = top-right
    offset = 20x20
    
    # Notification spacing
    gap_size = 8
    
    # Show indicator for hidden notifications
    indicate_hidden = yes
    
    # Notification transparency (requires compositor)
    transparency = 5

    ### Borders & Corners ###
    frame_width = 4
    frame_color = "#E7894C"
    corner_radius = 0

    # Separator between notifications
    separator_height = 2
    separator_color = "#262626"

    ### Padding ###
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 10

    ### Text ###
    font = RecMonoLinear Nerd Font Propo Medium 10
    line_height = 4
    
    # Allow basic markup
    markup = full
    
    # Message format: bold summary with body below
    format = "<b>%s</b>\n%b"
    
    # Text alignment
    alignment = left
    vertical_alignment = center
    
    # Word wrapping
    word_wrap = yes
    ellipsize = end
    
    # Show age of old messages
    show_age_threshold = 60
    
    # Ignore newlines in notifications
    ignore_newline = no
    
    # Stack duplicate notifications
    stack_duplicates = true
    hide_duplicate_count = false
    
    # Show URL/action indicators
    show_indicators = yes

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 0
    icon_path = /usr/share/icons/Adwaita/symbolic/status/:/usr/share/icons/Adwaita/symbolic/devices/:/usr/share/icons/hicolor/48x48/apps/

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### History ###
    sticky_history = yes
    history_length = 50

    ### Misc ###
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    force_xinerama = false
    
    # Idle timeout
    idle_threshold = 120

    ### Mouse Actions ###
    mouse_left_click = do_action, close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    # Muted style - dark bg with subtle foreground
    background = "#161616"
    foreground = "#B8AFA0"
    frame_color = "#262626"
    highlight = "#E7894C"
    timeout = 6

[urgency_normal]
    # Standard style - matches i3 bar look
    background = "#0F0F0F"
    foreground = "#F2ECDD"
    frame_color = "#E7894C"
    highlight = "#E7894C"
    timeout = 8

[urgency_critical]
    # BOLD Alert style - impossible to miss
    background = "#D9634F"
    foreground = "#0F0F0F"
    frame_color = "#D9634F"
    highlight = "#0F0F0F"
    timeout = 0

### App-Specific Rules ###

[spotify]
    appname = Spotify
    frame_color = "#7C9B96"
    timeout = 4

[discord]
    appname = discord
    frame_color = "#6A9FCC"

[slack]
    appname = Slack
    frame_color = "#8FC4C4"

[volume]
    appname = "volume*"
    highlight = "#E3A25A"
    timeout = 2

[brightness]
    appname = "brightness*"
    highlight = "#E3A25A"
    timeout = 2

[fullscreen_delay]
    fullscreen = delay

[fullscreen_critical]
    msg_urgency = critical
    fullscreen = show
