# Defensive shim only.
#
# Interactive zsh config now lives in $ZDOTDIR/.zshrc, and ZDOTDIR is exported
# from ~/.zshenv (always read first), so zsh normally reads $ZDOTDIR/.zshrc
# directly and never reaches this file. This shim only runs if ZDOTDIR was
# unset at startup — it restores it and loads the real config so nothing is
# silently skipped.
export ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
[ -f "$ZDOTDIR/.zshrc" ] && source "$ZDOTDIR/.zshrc"

fpath+=~/.zfunc; autoload -Uz compinit; compinit

zstyle ':completion:*' menu select
